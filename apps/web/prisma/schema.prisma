// ============================================================================
// santim-commerce — data model
//
// Design rules encoded here, each of which is a lesson:
//
//  1. MONEY IS AN INTEGER. Every amount is `Int` santim (1/100 ETB). There is
//     no Float anywhere in this schema, and there never will be.
//  2. PRODUCT ≠ VARIANT. Stock, price, and SKU live on the variant. This is
//     the single structural difference between a toy shop and a real one.
//  3. INVENTORY IS THREE NUMBERS, not one: onHand, reserved, and the derived
//     available = onHand - reserved. Reservations expire.
//  4. STATE IS AN ENUM, NOT A BOOLEAN. `paid: Boolean` cannot express
//     "authorised but not captured", "refunded", or "partially fulfilled".
//  5. PRICES ARE SNAPSHOTTED onto the order line. If the catalogue price
//     changes tomorrow, yesterday's invoice must not change with it.
//  6. EVERY EXTERNAL EVENT IS PERSISTED before it is acted on, with a unique
//     constraint that makes duplicate delivery a no-op.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------- sellers
//
// A marketplace, not a single-merchant shop: every Product belongs to
// exactly one Seller (see Product.sellerId below). Payment collection stays
// entirely unchanged — PaymentIntent is still one-per-Order against the
// platform's own SantimPay merchant account (a buyer never pays N different
// sellers directly; that's not how any real marketplace's payment flow
// works, SantimPay included). The seller split happens downstream, at
// fulfillment (OrderLine.sellerId) and at settlement (a seller's payable
// amount is computed from their OrderLines, not collected directly) — see
// docs/PROJECT-EXECUTION-STATE.md for the settlement-ledger work this
// foundation still needs.

model Seller {
  id      String @id @default(cuid())
  /// One store per user in v1 — deliberately simple. A user who wants a
  /// second store needs a second account, the same tradeoff most real
  /// marketplaces start with before building account-linking later.
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  storeName   String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String?

  status SellerStatus @default(PENDING)
  /// Audit trail for the verification/KYC decision — who and when, not just
  /// what. `reviewedBy` is a User.id stored as a plain string, not a
  /// relation: the reviewing admin's account outliving every seller they
  /// ever reviewed is not a constraint worth enforcing at the database
  /// level (same reasoning as OrderEvent.actor).
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  /// Marketplace commission on this seller's completed sales, in basis
  /// points (1000 = 10.00%). Per-seller, not global, because negotiated
  /// commission rates are a real, common marketplace feature — see
  /// Phase 8's settlement design.
  commissionBps Int @default(1000)

  products     Product[]
  orderLines   OrderLine[]
  ledgerEntries SellerLedgerEntry[]
  coupons      Coupon[]
  answeredQuestions ProductQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("sellers")
}

/// A real accounting ledger, not `seller_balance = seller_balance + amount`
/// — every financial fact about a seller's earnings is its own immutable,
/// append-only row (same "every external event is persisted" philosophy
/// this whole schema is built on, see the file header). A seller's current
/// payable balance is always `SUM(amountSantim) WHERE settledAt IS NULL`,
/// computed from real history, never trusted from a mutable running total.
///
/// Created by the worker's outbox consumer when an order's payment is
/// confirmed (see worker/index.ts's `deliver()` and settlement-service.ts)
/// — NOT synchronously inside the payment transaction itself, matching
/// this codebase's own established rule that side effects go through the
/// outbox, never a direct call inside the transaction that confirms
/// payment. `@@unique([orderLineId, type])` is what makes this safe under
/// the outbox's real at-least-once delivery semantics: a redelivered
/// "order.paid" message tries to insert the identical (orderLineId, type)
/// pair again, the database rejects the duplicate, settlement-service.ts
/// treats that as a no-op success — the same pattern WebhookEvent and
/// ShippingLabel already use elsewhere in this schema, not a new idea.
model SellerLedgerEntry {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  /// Denormalized alongside orderLineId for the same reason OrderLine
  /// snapshots sku/productTitle: a financial record must read correctly
  /// even if the relations it points at are queried differently later.
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  type LedgerEntryType

  /// Signed santim. Positive = credit (owed to the seller), negative =
  /// debit. A SALE entry and its COMMISSION entry on the same line always
  /// sum to the seller's real net for that sale — never stored as a single
  /// pre-netted number, so the commission actually charged is always
  /// independently auditable.
  amountSantim Int

  description String?

  /// NULL = still owed, not yet paid out. Set once a real payout
  /// mechanism exists and actually pays this entry — deliberately NOT
  /// built in this pass (see docs/PROJECT-EXECUTION-STATE.md: sending
  /// real money via SantimPay's B2C payout endpoint for seller payouts
  /// carries the same unconfirmed-gateway-semantics risk flagged for
  /// refunds in docs/01-santimpay-protocol-spec.md's own open questions —
  /// not something to guess at). This field exists so the ledger schema
  /// doesn't need to change again when that feature is actually built.
  settledAt DateTime?

  createdAt DateTime @default(now())

  @@unique([orderLineId, type])
  @@index([sellerId, settledAt])
  @@map("seller_ledger_entries")
}

enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  ADJUSTMENT
  /// Always negative — a seller-issued coupon's discount comes out of that
  /// seller's own payout, never the marketplace's. See Coupon's own
  /// comment and settlement-service.ts's createLedgerEntriesForOrder.
  COUPON_DISCOUNT
}

enum SellerStatus {
  /// Applied, awaiting admin review. Cannot list products yet.
  PENDING
  /// Reviewed and approved. Can list and sell.
  APPROVED
  /// Was approved, now blocked (policy violation, dispute rate, etc.) —
  /// existing listings hidden, no new sales, but history/payouts intact.
  SUSPENDED
  /// Reviewed and declined. Distinct from SUSPENDED: never actually sold.
  REJECTED
}

// ----------------------------------------------------------------- catalogue

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  slug        String   @unique
  title       String
  subtitle    String?
  description String   @db.Text
  brand       String?
  status      ProductStatus @default(DRAFT)

  // Merchandising
  featured    Boolean  @default(false)
  heroImage   String?
  images      ProductImage[]
  variants    Variant[]
  collections CollectionProduct[]
  reviews     ProductReview[]
  wishlistedBy WishlistItem[]
  recentlyViewedBy RecentlyViewed[]
  questions   ProductQuestion[]

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Postgres GENERATED ALWAYS AS ... STORED tsvector — Prisma's schema DSL
  /// and migration diff engine have no representation for generated
  /// columns, so this field exists only for documentation/introspection.
  /// The real column, its trigger-free generation expression, and its GIN
  /// index are hand-written SQL — see migration
  /// 20260820134234_add_product_search_vector and search-service.ts, which
  /// is the only code that ever touches it (via $queryRaw; Unsupported
  /// fields are excluded from the generated Prisma Client entirely).
  searchVector Unsupported("tsvector")?

  @@index([status, featured])
  @@index([sellerId, status])
  @@index([brand])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
  // Stored so the UI can reserve exact space and never shift layout (CLS).
  width     Int?
  height    Int?
  blurHash  String?

  @@index([productId, position])
  @@map("product_images")
}

/// A buyable thing. Price and stock live HERE, not on Product.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Unique per product, not globally — SKUs are a seller's own internal
  /// scheme (Product belongs to exactly one Seller), and two different
  /// sellers reusing "BLK-M" for their own unrelated items is normal, not
  /// a collision. See the @@unique below.
  sku       String
  title     String  // "Black / 42"
  /// Selected options as {"Colour":"Black","Size":"42"} — kept denormalised
  /// for display; the authoritative option data is in VariantOption.
  options   Json    @default("{}")

  /// Price in SANTIM. Never a Float.
  priceSantim        Int
  /// Original price for strike-through display, in santim.
  compareAtSantim    Int?
  /// What this unit cost us, for margin reporting.
  costSantim         Int?

  weightGrams Int?
  barcode     String?
  position    Int     @default(0)
  active      Boolean @default(true)

  inventory    Inventory?
  cartLines    CartLine[]
  orderLines   OrderLine[]
  reservations InventoryReservation[]
  backInStockRequests BackInStockRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId, active])
  @@map("variants")
}

/// Inventory as three numbers. `available` is derived, never stored — a stored
/// derived value is a bug waiting for a race condition.
model Inventory {
  variantId String  @id
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Physically in the warehouse.
  onHand    Int     @default(0)
  /// Held by in-flight checkouts. available = onHand - reserved.
  reserved  Int     @default(0)
  /// Allow selling below zero (backorder)?
  allowBackorder Boolean @default(false)
  /// Below this, the storefront shows "only N left".
  lowStockThreshold Int  @default(5)

  updatedAt DateTime @updatedAt

  @@map("inventory")
}

/// A time-boxed hold on stock, created at checkout and released on expiry.
/// Without this, two customers can buy the last unit in the seconds between
/// "add to cart" and "payment confirmed" — and one of them gets an apology.
model InventoryReservation {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quantity  Int
  status    ReservationStatus @default(HELD)
  /// Reservations MUST expire, or an abandoned checkout removes stock forever.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([orderId])
  // payment-service.ts queries HELD reservations for a specific order
  // (orderId + status together) when settling/releasing stock — the plain
  // orderId index above makes Postgres filter status in a post-scan instead
  // of using the index for both predicates.
  @@index([orderId, status])
  @@map("inventory_reservations")
}

enum ReservationStatus {
  HELD
  COMMITTED // payment succeeded; stock deducted from onHand
  RELEASED  // payment failed or expired; stock returned
}

// ------------------------------------------------------------------ reviews
//
// One review per (product, user) — @@unique below, a real database
// constraint, not an application-level "check if one exists first" (same
// discipline as everything else in this schema). `orderId` is the proof of
// a verified purchase: review-service.ts requires a real PAID-or-beyond
// order line for this exact product before a review can be created at
// all — not a cosmetic "Verified Purchase" badge bolted on after the fact,
// an actually-enforced precondition, per the master mandate's own framing
// of "reviews without eligible purchases" as an abuse vector to prevent,
// not a nice-to-have.
//
// No separate SellerReview model: a seller's aggregate rating is computed
// from the average of all reviews across their own products (real
// marketplaces mostly work this way at the foundation — Amazon's seller
// rating is itself an aggregate of buyer feedback, not a free-standing
// parallel review object) — see review-service.ts's getSellerRating.
model ProductReview {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The order that proves this reviewer actually bought this product.
  /// Restrict, not SetNull: a review's proof-of-purchase must never
  /// silently disappear if an order is ever deleted (same guardrail
  /// philosophy as every other Order-child FK in this schema).
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  rating Int /// 1-5, enforced by review-service.ts (Postgres has no native range-check via Prisma here)
  title  String?
  body   String  @db.Text

  status ReviewStatus @default(PUBLISHED)

  sellerResponse    String?   @db.Text
  sellerRespondedAt DateTime?

  reports ReviewReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("product_reviews")
}

enum ReviewStatus {
  PUBLISHED
  /// Hidden by an admin after moderation — not deleted, so the history and
  /// the report(s) that led to the decision stay auditable.
  HIDDEN
}

/// Who reported what, not just a bare counter — an admin moderating a
/// report needs to see the actual reasons, and `@@unique([reviewId,
/// reportedByUserId])` (a real constraint) is what stops one user
/// inflating a report count by reporting by the same review repeatedly.
model ReviewReport {
  id       String        @id @default(cuid())
  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reportedByUserId String
  reportedBy       User   @relation(fields: [reportedByUserId], references: [id], onDelete: Cascade)

  reason String

  createdAt DateTime @default(now())

  @@unique([reviewId, reportedByUserId])
  @@map("review_reports")
}

/// Pre-purchase Q&A, visible on the product page — the eBay/Amazon "Ask a
/// question" pattern. Deliberately NOT gated on proof-of-purchase the way
/// ProductReview is: the whole point is letting someone who HASN'T bought
/// yet get their question answered before they do. Answering is
/// ownership-scoped to the product's own seller, same discipline as every
/// other seller-scoped mutation in this codebase (see
/// product-qa-service.ts's `answerQuestion`).
///
/// A question with no answer yet is still real, visible content, not a
/// draft — other buyers benefit from seeing what's already been asked,
/// answered or not, matching how a real storefront's Q&A section works.
model ProductQuestion {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  askedByUserId String
  askedBy       User   @relation("QuestionsAsked", fields: [askedByUserId], references: [id], onDelete: Cascade)
  question      String @db.Text

  answer             String?   @db.Text
  answeredAt         DateTime?
  /// The STORE that answered, not a particular staff account — this app
  /// has no multi-user seller accounts (see Seller.ownerId's own comment:
  /// one store per user in v1), so referencing Seller directly here is the
  /// correct fit, the same way SellerLedgerEntry.sellerId does, not User.
  answeredBySellerId String?
  answeredBySeller   Seller?   @relation(fields: [answeredBySellerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("product_questions")
}

/// A customer's saved-for-later products. No separate "Wishlist" container
/// model — each user has exactly one implicit wishlist (their own set of
/// these rows), the same reasoning CartLine doesn't need a standalone
/// Cart-per-purpose abstraction beyond the Cart it already belongs to.
/// `@@unique([userId, productId])` is the real constraint that makes
/// "toggle" idempotent — adding an already-wishlisted product is a no-op,
/// not a duplicate row, enforced by the database, not an application-level
/// check-then-write.
model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

/// One row per (user, product) they've ever viewed, `viewedAt` overwritten
/// on every repeat view — an upsert, never an appended history, the same
/// "toggle, not a growing log" shape as WishlistItem's own unique
/// constraint. Signed-in users only, matching the established convention
/// in this codebase (wishlist, notifications) that engagement/tracking
/// features need an account; there's no cookie-based guest tracking here.
model RecentlyViewed {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  /// Real, DB-level monotonic counter, backed by an explicit Postgres
  /// sequence (see recently-viewed-service.ts's recordView) — NOT
  /// `viewedAt` and NOT `id`. This replaces an earlier, genuinely broken
  /// fix: ordering by `[viewedAt desc, id desc]` looks reasonable but is
  /// wrong the moment a row gets UPDATED rather than created — an
  /// upsert's update branch never changes `id`, so a product viewed
  /// LONG ago (smaller id) that gets RE-VIEWED now can still lose a
  /// `viewedAt` tie against a DIFFERENT product's row created more
  /// recently (larger id) but not re-viewed since — exactly backwards
  /// from "most recently viewed first". `viewedAt` alone ties at
  /// millisecond (JS Date) precision easily inside a fast test loop, and
  /// nothing about `id` tracks *when a row was last touched* rather than
  /// *when it was first created*. `touchSeq` is bumped via `nextval()` on
  /// EVERY view — create or update — so ordering is correct regardless of
  /// timestamp precision or which rows are old vs new.
  touchSeq BigInt @default(0)

  @@unique([userId, productId])
  @@index([userId, touchSeq])
  @@map("recently_viewed")
}

/// Scoped to a VARIANT, not the product — a sold-out size/color is what a
/// real customer is actually waiting on (see AddToCartForm's own
/// per-variant stock display), not the product as a whole.
///
/// `notifiedAt` doubles as the idempotency guard AND the re-arm mechanism:
/// once set, back-in-stock-service.ts's notify function skips this row —
/// a customer gets notified exactly once per real restock they asked
/// about, never spammed by every inventory update after the first. A
/// customer who wants ANOTHER heads-up for a later stockout re-requests,
/// which resets `notifiedAt` back to null rather than creating a second
/// row — see the real `@@unique([userId, variantId])` below.
model BackInStockRequest {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  notifiedAt DateTime?
  /// Incremented each real notify — NOT just a counter for display.
  /// `id` alone is stable across a re-arm cycle (create-or-update on the
  /// same @@unique row), so a dedupeKey built from `id` alone would
  /// collide forever after the FIRST notification and silently swallow
  /// every real notification after a re-arm. This field makes each
  /// notify-cycle's dedupeKey genuinely distinct while staying stable
  /// (and therefore still idempotent) within a single cycle's redeliveries.
  notificationCount Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([userId, variantId])
  @@index([variantId, notifiedAt])
  @@map("back_in_stock_requests")
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  heroImage   String?
  position    Int     @default(0)
  products    CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

// --------------------------------------------------------------------- users

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  phone        String? @unique  // E.164, normalised at the boundary
  name         String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  emailVerifiedAt DateTime?

  /// Trust & safety enforcement against a CUSTOMER account — fraud,
  /// harassment, chargebacks. Deliberately a nullable timestamp, the same
  /// "null = normal, set = the real thing happened" convention already
  /// used throughout this schema (Order.cancelledAt,
  /// SellerLedgerEntry.settledAt, PasswordResetToken.usedAt), not a new
  /// enum, since this is a plain binary state. Independent of
  /// Seller.status — suspending a user's ability to sign in/order/review
  /// does not itself touch whether their storefront (if they have one) is
  /// live; that already has its own real suspend/reinstate flow.
  suspendedAt      DateTime?
  suspendedReason  String?
  suspendedByAdmin String?

  orders    Order[]
  carts     Cart[]
  addresses Address[]
  sessions  Session[]
  passwordResetTokens PasswordResetToken[]
  /// Present only if this user has applied to sell — see Seller.ownerId's
  /// own comment on why this is 1:1, not 1:N, in v1.
  seller    Seller?
  reviews       ProductReview[]
  reviewReports ReviewReport[]
  returnRequests ReturnRequest[]
  couponRedemptions CouponRedemption[]
  wishlistItems WishlistItem[]
  recentlyViewed RecentlyViewed[]
  backInStockRequests BackInStockRequest[]
  notifications Notification[]
  questionsAsked ProductQuestion[] @relation("QuestionsAsked")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

/// Database-backed sessions, not stateless JWTs.
///
/// A JWT session is unrevocable without a blocklist — the moment you need
/// one, you have rebuilt this table anyway, just with extra steps and a
/// window where a revoked token still works. For a payments-adjacent app,
/// "log this device out right now" (compromised account, lost phone) has to
/// be instant and unconditional. A row delete gives that; a stateless token
/// does not.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie value — never the raw token. A leaked database
  /// backup must not hand out working sessions, the same reasoning applied
  /// to the SantimPay private key never appearing in logs.
  tokenHash String @unique

  userAgent String?
  ipAddress String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Admin-issued account-recovery token. Same hash-only-stored discipline as
/// Session.tokenHash above — the raw token exists only for the instant it's
/// generated (returned once to the admin who issued it) and in the URL the
/// admin relays to the user through their own real, off-system channel
/// (support ticket, phone). This system has no real email/SMS provider
/// credentials (see notification-service.ts's own comment) so a
/// self-service "email me a reset link" flow cannot be honestly built here
/// — this is the honest alternative: a real, single-use, time-limited
/// token, issued by a trusted admin, never a fabricated "email sent"
/// claim.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  issuedByAdmin String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName   String
  phone      String
  city       String
  subCity    String?
  woreda     String?
  streetLine String?
  landmark   String?
  notes      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------- cart

model Cart {
  id        String  @id @default(cuid())
  /// Anonymous cart token, set as an httpOnly cookie before login.
  token     String  @unique
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    CartStatus @default(ACTIVE)
  lines     CartLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  @@index([userId, status])
  @@map("carts")
}

enum CartStatus {
  ACTIVE
  CONVERTED // became an order
  ABANDONED
}

model CartLine {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  /// Price when the item was added. Compared against the live price at
  /// checkout so we can tell the customer "this went up" instead of silently
  /// charging a different number than the one they saw.
  unitPriceSantim Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_lines")
}

// -------------------------------------------------------------------- orders

model Order {
  id          String @id @default(cuid())
  /// Human-facing, e.g. "SC-2K4F7Q". Shown to customers and support.
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contact captured at checkout — guests are first-class.
  email String
  phone String

  status          OrderStatus     @default(PENDING_PAYMENT)
  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)

  // Every total in santim, snapshotted at placement.
  subtotalSantim  Int
  discountSantim  Int @default(0)
  shippingSantim  Int @default(0)
  taxSantim       Int @default(0)
  totalSantim     Int
  currency        String @default("ETB")

  shippingAddress Json?
  billingAddress  Json?
  customerNote    String?

  lines          OrderLine[]
  payments       PaymentIntent[]
  events         OrderEvent[]
  reservations   InventoryReservation[]
  shippingLabels ShippingLabel[]
  ledgerEntries  SellerLedgerEntry[]
  reviews        ProductReview[]
  returnRequests ReturnRequest[]
  couponRedemption CouponRedemption?

  placedAt    DateTime @default(now())
  paidAt      DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([status, placedAt])
  @@index([userId, placedAt])
  @@index([email])
  // admin-queries.ts's "paid today" dashboard filters on exactly this pair
  // (status = PAID, paidAt >= startOfDay) — status+placedAt above doesn't
  // cover it, placedAt and paidAt are different moments for the same order.
  @@index([status, paidAt])
  @@map("orders")
}

// ------------------------------------------------------------ promotions

/// Admin-issued (sellerId null) or seller-issued (sellerId set) coupons.
/// A seller-issued coupon's discount base is that seller's OWN lines in the
/// cart, never the whole cart subtotal — see coupon-service.ts's
/// `relevantSubtotal` for the actual per-seller-vs-whole-cart math, and
/// settlement-service.ts for how a seller-scoped discount comes out of
/// THAT seller's own ledger (a new COUPON_DISCOUNT entry), never the
/// marketplace's. An admin coupon (sellerId null) still discounts the
/// whole cart and is still absorbed by the marketplace, unchanged from
/// before this feature existed.
model Coupon {
  id          String @id @default(cuid())
  /// Always stored/looked-up uppercase — see coupon-service.ts.
  code        String @unique
  description String?

  /// Null = admin/platform-wide. Set = scoped to this seller's own lines only.
  sellerId String?
  seller   Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  discountType  CouponDiscountType
  /// PERCENTAGE: whole points, e.g. 10 = 10%. FIXED_AMOUNT: santim.
  discountValue Int
  /// Caps a PERCENTAGE discount's absolute santim value. Ignored for FIXED_AMOUNT.
  maxDiscountSantim Int?
  minSubtotalSantim Int @default(0)

  /// Total redemptions allowed across all customers. Null = unlimited.
  /// Decremented with an atomic conditional UPDATE inside the checkout
  /// transaction (same pattern as inventory reservation) so concurrent
  /// checkouts can never oversell a limited coupon.
  redemptionsRemaining Int?

  validFrom  DateTime?
  validUntil DateTime?
  /// Admin/seller kill-switch, independent of the date window.
  active     Boolean @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sellerId])
  @@map("coupons")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// One row per successful redemption. `@@unique([couponId, userId])` is the
/// hard, database-enforced "one use per customer per coupon" rule in v1 —
/// see coupon-service.ts for why this replaces a general per-user counter.
model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Snapshotted actual discount applied — Coupon's own rules can change
  /// later, this row must not.
  discountSantim Int

  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@map("coupon_redemptions")
}

enum OrderStatus {
  PENDING_PAYMENT // created, awaiting the gateway
  PAID            // money confirmed by the status API
  FAILED          // payment failed or declined
  CANCELLED       // cancelled by customer or by reservation expiry
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfilmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  // Restrict, not Cascade: "a historical record, not a view" (below) means
  // deleting the parent Order must never silently take this with it. No
  // code path deletes an Order today (grep confirms it), so this changes
  // no current behaviour — it only blocks a future one from doing it by
  // accident.
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Snapshotted at order-placement time, same reasoning as sku/productTitle
  /// below: which seller gets paid for this line must never change even if
  /// the product is later reassigned or the seller record changes. Restrict,
  /// not SetNull — a seller with real order history attached must never be
  /// hard-deletable (same guardrail philosophy as Order's own children).
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  // Snapshotted so the invoice stays true even if the catalogue changes or
  // the product is deleted. An order line is a historical record, not a view.
  sku             String
  productTitle    String
  variantTitle    String
  imageUrl        String?
  unitPriceSantim Int
  quantity        Int
  lineTotalSantim Int

  /// Per-LINE fulfilment, not just Order.fulfilmentStatus — a multi-seller
  /// order needs this: seller A can ship their item while seller B hasn't,
  /// and a single Order-level field cannot represent that. Order's own
  /// fulfilmentStatus is now a DERIVED aggregate of its lines (see
  /// seller-order-fulfillment.ts) — not a second source of truth to keep
  /// in sync by hand.
  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)
  fulfilledAt       DateTime?

  ledgerEntries SellerLedgerEntry[]
  returnRequest ReturnRequest?

  createdAt DateTime @default(now())

  @@index([orderId])
  // Seller order management ("show me my sold items") filters on exactly
  // this — a seller's own lines ordered by recency.
  @@index([sellerId, createdAt])
  @@map("order_lines")
}

/// One return request per line, ever, in v1 — a rejected request is final
/// (a real escalation/dispute path is a genuinely separate feature, not
/// half-built here). Can only be requested once the line is FULFILLED —
/// you return something that was actually delivered, not something still
/// in transit or never shipped.
///
/// Approving a return does three real things together, in one transaction
/// (see return-service.ts): restocks the variant's real inventory
/// (Inventory.onHand), moves the OrderLine to RETURNED (excluded from the
/// fulfilment aggregate — see fulfilment-aggregate.ts's own comment on
/// why), and reverses the seller's settlement via a real REFUND ledger
/// entry (SellerLedgerEntry, not a mutable balance edit). It does NOT
/// trigger an actual bank transfer back to the customer — see
/// settlement-service.ts's own comment on why real money movement against
/// SantimPay's unconfirmed refund semantics is deliberately out of scope.
model ReturnRequest {
  id String @id @default(cuid())

  orderLineId String        @unique
  orderLine   OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  requestedByUserId String
  requestedBy       User   @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reason            String @db.Text

  status ReturnRequestStatus @default(REQUESTED)

  /// The seller (their own line) or an admin — whoever actually decided.
  resolvedByUserId String?
  resolutionNote   String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("return_requests")
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Append-only audit trail. When a customer asks "what happened to my order",
/// this is the answer, and when an auditor asks, this is the evidence.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  // Restrict: this is the audit trail itself (see the model doc above) —
  // deleting the Order it documents must never take the evidence with it.
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type      String   // "order.placed", "payment.completed", "stock.committed"
  message   String?
  data      Json?
  /// Who caused it: "system", "webhook", "reconciler", or a user id.
  actor     String   @default("system")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ------------------------------------------------------------------ payments

/// A single attempt to collect money. An order can have several — a customer
/// whose Telebirr payment fails may retry with CBE Birr, and both attempts
/// must be recorded. This is why payment state does not live on Order.
model PaymentIntent {
  id      String @id @default(cuid())
  orderId String
  // Restrict: this is the financial record of every attempted charge — the
  // one thing in this whole schema that must never disappear as a side
  // effect of deleting something else.
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// OUR id sent to SantimPay as `id`. THE idempotency key for the payment.
  /// Generated once, persisted BEFORE the outbound call.
  merchantTxnId String @unique

  provider String @default("santimpay")
  status   PaymentStatus @default(CREATED)

  amountSantim     Int
  commissionSantim Int  @default(0)
  totalSantim      Int  @default(0)
  currency         String @default("ETB")

  /// Set once the gateway responds.
  gatewayTxnId  String?  @unique
  /// The bank's/channel's own reference — what the customer's SMS shows.
  channelRef    String?
  channel       String?  // "Telebirr", "CBE Birr", ...
  msisdn        String?
  paymentUrl    String?  @db.Text

  failureCode    String?
  failureMessage String?

  /// Poller bookkeeping.
  pollAttempts  Int       @default(0)
  nextPollAt    DateTime?
  lastPolledAt  DateTime?

  events    WebhookEvent[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, nextPollAt])
  @@index([orderId])
  // admin-queries.ts's "stuck payments" dashboard filters/counts on this
  // exact pair (status IN [...], createdAt < cutoff) — status+nextPollAt
  // above serves the poller's own query, not this one.
  @@index([status, createdAt])
  @@map("payment_intents")
}

enum PaymentStatus {
  CREATED    // intent persisted, gateway not yet called
  PENDING    // gateway has it; awaiting the channel
  COMPLETED
  FAILED
  DECLINED
  EXPIRED    // never resolved within our window
  REFUNDED
}

/// Every inbound callback, stored raw BEFORE processing.
///
/// The unique constraint on (provider, gatewayTxnId, status) is what makes
/// duplicate webhook delivery a no-op. Gateways retry; assume at-least-once
/// delivery, always. This table is also the forensic record when a customer
/// insists they paid.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String @default("santimpay")

  gatewayTxnId String
  status       String
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  /// Raw body exactly as received. Never re-serialised.
  rawBody       String  @db.Text
  signature     String? @db.Text
  signatureValid Boolean @default(false)

  processedAt DateTime?
  error       String?  @db.Text

  receivedAt DateTime @default(now())

  @@unique([provider, gatewayTxnId, status])
  @@index([processedAt])
  @@map("webhook_events")
}

/// Transactional outbox: side effects (email, SMS, search reindex) are written
/// in the SAME database transaction as the state change that caused them, then
/// published by a worker. This is the standard answer to the dual-write
/// problem — you cannot atomically commit a row and call an external API.
model OutboxMessage {
  id          String   @id @default(cuid())
  topic       String
  payload     Json
  attempts    Int      @default(0)
  publishedAt DateTime?
  lastError   String?  @db.Text
  availableAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt, availableAt])
  @@map("outbox_messages")
}

/// In-app customer notifications — populated by the outbox worker (see
/// worker/index.ts's deliver()), never written directly inside the same
/// transaction as the state change that caused them, same reasoning as
/// every other outbox-driven side effect. No real email/SMS provider
/// credentials exist in this environment (see docs/PROJECT-EXECUTION-
/// STATE.md), so this is the honest, buildable version of "notify the
/// customer" rather than a fabricated integration.
///
/// `dedupeKey` is the real idempotency guard under the outbox's at-least-
/// once delivery semantics — a redelivered "order.paid" message must not
/// double-notify the customer, enforced by this unique constraint, not an
/// application-level check-then-write (same pattern as SellerLedgerEntry's
/// `@@unique([orderLineId, type])`).
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title String
  body  String
  /// Where "view" should take the customer, e.g. /account/orders/SC-1234.
  link  String?

  dedupeKey String? @unique
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ORDER_PAID
  ORDER_PAYMENT_FAILED
  ORDER_LINE_FULFILLED
  RETURN_APPROVED
  RETURN_REJECTED
  QUESTION_ANSWERED
  BACK_IN_STOCK
}

/// At most one shipping label per order — `orderId` is `@unique`, not just
/// indexed, and THAT constraint (not application logic) is what makes
/// concurrent label-generation requests for the same order safe. Same
/// pattern as WebhookEvent's unique constraint and Inventory's atomic
/// UPDATE: let the database reject the second writer, never a
/// check-then-write race in application code.
///
/// Curriculum Phase 12 §2 / Lab 12.2: rate quotes (carrier-client.ts's
/// getRateQuote) are naturally idempotent — a pure calculation, safe to
/// call any number of times. Label generation is a real, billable side
/// effect and needs this row to exist BEFORE the carrier is ever called,
/// the identical ordering discipline `startPayment()` uses for
/// `PaymentIntent.merchantTxnId`.
model ShippingLabel {
  id      String @id @default(cuid())
  orderId String @unique
  // Restrict: a real, billable carrier transaction lives behind this row —
  // same reasoning as PaymentIntent, deliberately not Cascade.
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// OUR id, sent to the carrier as ITS idempotency key. Generated once,
  /// persisted before the outbound call — see label-service.ts.
  idempotencyKey String @unique

  status ShippingLabelStatus @default(PENDING)

  /// Set once the carrier responds.
  carrierLabelId String?
  trackingNumber String?
  labelUrl       String? @db.Text

  failureMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@map("shipping_labels")
}

enum ShippingLabelStatus {
  PENDING   // key persisted, carrier not yet called (or in flight)
  GENERATED // carrier returned a real label
  FAILED
}
