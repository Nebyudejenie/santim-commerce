# =============================================================================
# santim-commerce — environment template
#
# Copy to .env.local for development. NEVER commit a filled-in copy.
# .env.local is gitignored; the private key below is a bearer credential for
# BOTH directions of the SantimPay integration (see docs §1.1) — leaking it
# lets someone both spend from your escrow and forge your webhooks.
# =============================================================================

NODE_ENV=development
# development | staging | production — decoupled from NODE_ENV on purpose;
# see env.ts's field comment. Only "production" enforces the
# testbed-vs-real-money and HTTPS boot-time guards.
DEPLOY_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://santim:santim@localhost:5432/santim_commerce?schema=public

# -----------------------------------------------------------------------------
# Public origin
#
# SantimPay must be able to reach APP_URL/api/webhooks/santimpay from the public
# internet. `localhost` will never receive a callback — during development run a
# tunnel and paste its HTTPS URL here:
#
#   cloudflared tunnel --url http://localhost:3000
#   # or: ngrok http 3000
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SantimPay
#
# Issued per environment on the integration group. The testbed key will NOT
# work against production URLs — you get "crypto/ecdsa: verification error".
# -----------------------------------------------------------------------------
SANTIMPAY_ENVIRONMENT=testbed
SANTIMPAY_MERCHANT_ID=9e2dab64-e2bb-4837-9b85-d855dd878d2b

# Multi-line PEM. Either inline it with \n escapes, or use the _B64 form below,
# which is what most secret managers and CI systems prefer.
SANTIMPAY_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nREPLACE_ME\n-----END EC PRIVATE KEY-----"
# SANTIMPAY_PRIVATE_KEY_B64=

# Required when SANTIMPAY_ENVIRONMENT=production (integration document p.5).
SANTIMPAY_GATEWAY_TOKEN=

SANTIMPAY_TIMEOUT_MS=15000
WEBHOOK_MAX_AGE_SECONDS=300

# -----------------------------------------------------------------------------
# Commerce behaviour
# -----------------------------------------------------------------------------
# How long a checkout holds stock. Too short and slow payers lose their cart;
# too long and a few abandoned checkouts make popular items look sold out.
RESERVATION_TTL_MINUTES=20

# -----------------------------------------------------------------------------
# Sessions — generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
