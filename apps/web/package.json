{
  "name": "@santim/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --test --experimental-strip-types $(find src -name '*.test.ts' ! -name '*.integration.test.ts')",
    "test:integration": "tsx --test $(find src -name '*.integration.test.ts')",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/worker/index.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "loadtest:seed-orders": "tsx scripts/seed-load-test-orders.ts",
    "loadtest:seed-webhooks": "tsx scripts/generate-webhook-fixtures.ts",
    "chaos:checkout-atomicity": "tsx scripts/chaos-checkout-atomicity.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@santim/santimpay": "workspace:*",
    "next": "^15.1.6",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.2.1",
    "typescript": "^5.9.2"
  }
}
